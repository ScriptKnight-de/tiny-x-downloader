# Copy to .env (docker compose reads it automatically)

# Your X handle, without the @ (needed for the likes timeline)
X_USERNAME=

# Host user/group that should own downloaded files (run `id -u` / `id -g`)
PUID=1000
PGID=1000

TZ=Europe/Berlin
# Daily sync time (local, HH:MM) and optional immediate sync at container start
X_SYNC_TIME=04:00
X_RUN_ON_START=true

# Image to run (default: latest from the Forgejo registry; needs `docker login forgejo.scriptknight.de`)
# X_DOWNLOADER_IMAGE=forgejo.scriptknight.de/scriptknight/x-downloader:latest

# Host paths
X_COOKIES_FILE=./config/cookies.txt
X_DATA_DIR=./data
X_DOWNLOADS_DIR=./downloads

# --- Only for running without Docker (CLI / systemd timer) ---
# X_COOKIES=~/.config/x-downloader/cookies.txt
# X_DOWNLOADER_OUTPUT_DIR=~/Pictures/x-downloader
# X_DOWNLOADER_ARCHIVE=~/.local/share/x-downloader/archive.sqlite3
