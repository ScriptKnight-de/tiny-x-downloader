# Copy to .env (docker compose reads it automatically)

# Host user/group that should own downloaded files (run `id -u` / `id -g`)
PUID=1000
PGID=1000

TZ=Europe/Berlin
# Daily sync time (local, HH:MM) and optional immediate sync at container start
X_SYNC_TIME=04:00
X_RUN_ON_START=true

# Alerts for failed syncs and expired/expiring login cookies (all optional, set any of them)
# X_GOTIFY_URL=https://gotify.example.com
# X_GOTIFY_TOKEN=
# X_NTFY_URL=https://ntfy.sh/pick-a-long-random-topic-name
# X_NTFY_TOKEN=
# X_WEBHOOK_URL=https://example.com/hook     # receives JSON: app, version, title, message, priority
# X_COOKIE_WARN_DAYS=7                       # warn this many days before the login cookie expires

# Image to run (default: latest published image; set this to pin a version, e.g. :0.5.0)
# TINY_X_DOWNLOADER_IMAGE=forgejo.scriptknight.de/scriptknight/tiny-x-downloader:latest

# Host paths
# Folder that contains cookies.txt
X_CONFIG_DIR=./config
X_DATA_DIR=./data
X_DOWNLOADS_DIR=./downloads

# --- Only for running without Docker (CLI / systemd timer) ---
# X_COOKIES=~/.config/tiny-x-downloader/cookies.txt
# TINY_X_DOWNLOADER_OUTPUT_DIR=~/Pictures/tiny-x-downloader
# TINY_X_DOWNLOADER_ARCHIVE=~/.local/share/tiny-x-downloader/archive.sqlite3
