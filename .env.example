# Copy to ~/.config/x-downloader/env (used by the daily timer) or ./.env

# Your X handle, without the @ (needed for the likes timeline)
X_USERNAME=

# Netscape-format cookies.txt exported from a browser where you are logged in to x.com
X_COOKIES=~/.config/x-downloader/cookies.txt

# Where downloaded media goes (subfolders: likes/, bookmarks/). Files may be moved afterwards.
X_DOWNLOADER_OUTPUT_DIR=~/Pictures/x-downloader

# Memory of what was already downloaded. Keep it OUTSIDE the output dir.
X_DOWNLOADER_ARCHIVE=~/.local/share/x-downloader/archive.sqlite3
